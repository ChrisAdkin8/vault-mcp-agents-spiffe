# Required: LLM API key for the agent
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: GCP secrets engine configuration
# Pre-provision GCP resources with Terraform (see terraform/README.md), then
# set these variables to enable the Vault GCP secrets engine with 5-minute
# credential TTLs. If GCP_SA_KEY_FILE is not set, the GCP secrets engine is
# skipped and the stack starts without GCP credential brokering.
#
# GCP_SA_KEY_FILE=./path/to/your-sa-key.json
# DATA_AGENT_SA_EMAIL=data-agent-gcp@YOUR_PROJECT.iam.gserviceaccount.com
# COMPUTE_AGENT_SA_EMAIL=compute-agent-gcp@YOUR_PROJECT.iam.gserviceaccount.com
